{
  "name": "mentra-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:mobile": "node --env-file-if-exists=.env scripts/start-mobile.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:voice": "playwright test --config playwright.voice.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.55.0"
  },
  "engines": {"node": ">=24"}
}
