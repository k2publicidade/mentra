# Copy to .env (ignored by Git). npm start reads this file; never send real keys in chat.
# Desktop default. HTTPS mobile launcher overrides host/port and sets Secure cookies.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/mentra.sqlite
NODE_ENV=development
VOICE_PROVIDER=brainiall
BRAINIALL_API_KEY=
# Optional alternative, only if VOICE_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional direct HTTPS paths; start:mobile uses generated data/tls defaults.
# TLS_CERT_PATH=./data/tls/server.crt
# TLS_KEY_PATH=./data/tls/server.key
# Never use VITE_* for secrets. No arbitrary provider URL is accepted from environment.

# Vercel online-only backend (server environment, never VITE_*).
# Local npm start remains SQLite and ignores these settings.
# SUPABASE_URL=https://mmhvbjmetsuscnyzsvxg.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# SESSION_SECRET=
# APP_ORIGIN=https://your-canonical-host.example
# DATABASE_CA_CERT=   # Optional trusted Supabase root CA PEM.
# See ONLINE_DEPLOYMENT.md for migration order, Auth, pooler and verification.
